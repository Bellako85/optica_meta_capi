<odoo>
    <record id="view_order_form_meta_capi_button" model="ir.ui.view">
        <field name="name">sale.order.form.meta.capi.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_purchase_to_meta"
                        type="object"
                        string="Enviar Purchase a Meta"
                        class="btn-primary"
                        invisible="x_meta_purchase_sent"/>
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">
                <page string="Meta CAPI">
                    <group>
                        <field name="x_meta_purchase_sent"/>
                        <field name="x_meta_purchase_event_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
